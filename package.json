{
  "name": "@hraness/eds-research",
  "version": "0.1.0",
  "private": true,
  "description": "EDS Research Index is an independent, open-source index of Ehlers-Danlos syndromes research that links each record's sources and labels the kind of evidence.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/eds-research.git"
  },
  "homepage": "https://hraness.com/eds",
  "bugs": {
    "url": "https://github.com/hraness/eds-research/issues"
  },
  "keywords": [
    "ehlers-danlos",
    "eds",
    "heds",
    "hypermobility",
    "rare-disease",
    "connective-tissue",
    "patient-research",
    "medical-history",
    "open-data",
    "research-index",
    "nextjs",
    "typescript",
    "bun"
  ],
  "scripts": {
    "build": "next build",
    "check": "bun run research:audit && bun run typecheck && bun run lint && bun run test",
    "dev": "next dev",
    "lint": "eslint .",
    "research:audit": "bun run scripts/audit-eds-research.ts",
    "research:source-id": "bun run scripts/source-id.ts",
    "search:indexnow": "bun run scripts/submit-indexnow.ts",
    "start": "next start",
    "test": "bun test ./app ./lib ./scripts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hraness/site-footer": "github:hraness/site-footer#v0.12.0",
    "@hraness/vercel-delivery": "github:hraness/vercel-delivery#v0.1.2",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.6.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3"
  }
}
